# GradInvite backend environment.
# Copy to backend/.env for local use (that file is gitignored).
# When deploying, set the same keys in your hosting platform's environment settings.

# Server
NODE_ENV=production
PORT=3000
# Browser origins allowed to call the API when the frontend is hosted elsewhere, comma-separated (e.g. https://your-app.vercel.app).
# Leave empty when the backend serves the frontend itself.
CORS_ORIGIN=

# MongoDB connection string. The database named in the path (gradinvite_db) is created on the first write.
# Atlas example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gradinvite_db?retryWrites=true&w=majority
# Local example: mongodb://localhost:27017/gradinvite_db
MONGODB_URI=
# Database name when the URI has none in its path (required for Atlas URIs ending in /?appName=...).
MONGODB_DB=gradinvite_db

# Secret used to sign the 24-hour login JWT. Use a long random string (32+ characters). Required in production.
JWT_SECRET=replace-with-a-long-random-string

# Administrator account, created automatically at startup if it does not exist (admin panel at /admin).
# Quote the password if it contains # or spaces.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Brevo email. MAIL_FROM must be a sender verified in Brevo.
# Preferred: SMTP relay (Brevo > SMTP & API > SMTP tab). Not affected by the "authorised IPs" list, works from any server.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
# Optional: REST API key. Used for sending only when SMTP is not set; also powers the credits display in the admin panel.
BREVO_API_KEY=
MAIL_FROM=
# Display name shown as the sender and used in email subjects.
MAIL_FROM_NAME=Graduant-ntuma.invite
