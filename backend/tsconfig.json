{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "server",
    "shared",
    "*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
